# macOS
.DS_Store

# Xcode project — generated by XcodeGen from project.yml, not checked in.
# Run `xcodegen generate` after cloning or after editing project.yml.
*.xcodeproj/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Local NTFS fixture images generated by dev-tools/make-ntfs-fixture*.sh —
# regenerate with those scripts instead of committing them.
dev-tools/*.sparseimage
